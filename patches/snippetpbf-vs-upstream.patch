+	const int W = 512, H = 512, planks = 6;
+	std::vector<unsigned char> px(W * H * 3);
+	for (int j = 0; j < H; ++j)
+	{
+		const float v = (float(j) + 0.5f) / float(H);
+		for (int i = 0; i < W; ++i)
+		{
+			const float u = (float(i) + 0.5f) / float(W);
+			const int   p = int(u * planks);
+			const float pu = u * planks - float(p);                 // 0..1 across this plank
+			const float seamOff = hash2(p, 7) ;                     // staggered end seams
+			const float pv = fmodf(v + seamOff, 1.0f);
+			// per-plank tint
+			const float tint = 0.85f + 0.3f * hash2(p, 3);
+			const float warm = 0.9f + 0.2f * hash2(p, 11);
+			// grain: stretched noise along v with fine streaks
+			const float g1 = fbm(pu * 3.0f + p * 17.0f, v * 40.0f + p * 5.0f, 4);
+			const float g2 = vnoise(pu * 60.0f + p * 31.0f, v * 400.0f);
+			const float grain = 0.72f + 0.35f * g1 + 0.08f * g2;
