+
+void orbitMotion(int x, int y)
+{
+	sCursorX = x; sCursorY = y;
+	if (sSliderDrag >= 0) { sliderSetFromX(sSliderDrag, x); return; }
+	if (sDragTile) { dragTileTo(x, y); return; }
+	const int dx = x - sLastX, dy = y - sLastY;
+	sLastX = x; sLastY = y;
+	if (sButton == GLUT_LEFT_BUTTON)
+	{
+		sYaw   -= float(dx) * 0.005f;
+		sPitch  = PxClamp(sPitch + float(dy) * 0.005f, -1.55f, 1.55f);
+	}
+	else if (sButton == GLUT_RIGHT_BUTTON)
+	{
+		const PxVec3 dir = orbitDir();
+		const PxVec3 right = dir.cross(PxVec3(0, 1, 0)).getNormalized();
+		const PxVec3 up = right.cross(dir);
+		const float k = sDist * 0.0015f;
+		sTarget += right * (-float(dx) * k) + up * (float(dy) * k);
+	}
+	else if (sButton == GLUT_MIDDLE_BUTTON)
+	{
+		sDist = PxClamp(sDist * expf(float(dy) * 0.01f), 0.2f, 20.0f);
+	}
+}
+
+// ---- low-poly pistol-grip spray nozzle (after a Dramm-style garden sprayer)
+// Local frame at the spray-head face: +x forward along the spray, +y "up" (perpendicular, in the
+// run plane), +z sideways.  Water is emitted from the origin, i.e. the centre of the head.
+static GLUquadric* sQuad = NULL;
+static const float kHoseScale = 0.6f;   // the sprayer model is drawn at 60% so it suits the 150 mm tiles
+
+void cylBetween(const PxVec3& p0, const PxVec3& p1, float r0, float r1, int slices, bool caps)
+{
+	const PxVec3 d = p1 - p0;
+	const float len = d.magnitude();
+	if (len < 1e-6f) return;
+	const PxVec3 z(0, 0, 1);
+	PxVec3 axis = z.cross(d / len);
+	const float ang = acosf(PxClamp(z.dot(d / len), -1.0f, 1.0f)) * 180.0f / PxPi;
+	if (axis.magnitudeSquared() < 1e-8f) axis = PxVec3(0, 1, 0);
+	glPushMatrix();
+	glTranslatef(p0.x, p0.y, p0.z);
+	glRotatef(ang, axis.x, axis.y, axis.z);
+	gluCylinder(sQuad, r0, r1, len, slices, 1);
+	if (caps)
+	{
+		gluQuadricOrientation(sQuad, GLU_INSIDE);  gluDisk(sQuad, 0.0, r0, slices, 1);
+		gluQuadricOrientation(sQuad, GLU_OUTSIDE); glTranslatef(0, 0, len); gluDisk(sQuad, 0.0, r1, slices, 1);
+	}
+	glPopMatrix();
+}
+
+void sphereAt(const PxVec3& p, float r, int slices)
+{
+	glPushMatrix(); glTranslatef(p.x, p.y, p.z); gluSphere(sQuad, r, slices, slices / 2 + 2); glPopMatrix();
+}
+
+void drawHose()
+{
+	if (!sQuad) { sQuad = gluNewQuadric(); gluQuadricNormals(sQuad, GLU_SMOOTH); }
+	PxVec3 tip, dir; PxReal r; getHose(tip, dir, r);
+	const bool on = isHoseOn();
+	const float t = float(glutGet(GLUT_ELAPSED_TIME)) * 0.001f;
+	const bool invite = !on && getActiveParticles() == 0;
+	const float pulse = invite ? 0.75f + 0.25f * sinf(t * 4.0f) : 1.0f;
+
+	// local frame -> world
+	const PxVec3 X = dir.getNormalized(), Z(0, 0, 1), Y = Z.cross(X);
+	const float m[16] = { X.x, X.y, X.z, 0,  Y.x, Y.y, Y.z, 0,  Z.x, Z.y, Z.z, 0,  tip.x, tip.y, tip.z, 1 };
+
+	const PxVec3 orange(1.0f * pulse, 0.42f * pulse, 0.05f * pulse), black(0.10f, 0.10f, 0.11f);
+	const PxVec3 rubber(0.14f, 0.14f, 0.15f), brass(0.80f, 0.65f, 0.30f), steel(0.75f, 0.76f, 0.78f);
+
+	glPushAttrib(GL_ENABLE_BIT | GL_CURRENT_BIT);
+	glEnable(GL_LIGHTING);
+	glDisable(GL_CULL_FACE);
+	glDisable(GL_TEXTURE_2D);
+	glPushMatrix();
+	glMultMatrixf(m);
+	glScalef(kHoseScale, kHoseScale, kHoseScale);
+
+	// spray head: wide black dial with a face of pattern holes, orange band behind it
+	glColor3fv(&black.x);
+	cylBetween(PxVec3(-0.034f, 0, 0), PxVec3(0, 0, 0), 0.034f, 0.034f, 20, true);
+	glColor3fv(&orange.x);
+	cylBetween(PxVec3(-0.050f, 0, 0), PxVec3(-0.034f, 0, 0), 0.030f, 0.032f, 20, true);
+	// pattern holes ring + centre jet
+	glColor3f(0.05f, 0.05f, 0.05f);
+	for (int i = 0; i < 8; ++i)
+	{
+		const float a = float(i) * (2.0f * PxPi / 8.0f);
+		sphereAt(PxVec3(0.0f, 0.021f * cosf(a), 0.021f * sinf(a)), 0.0045f, 8);
+	}
+	if (on) glColor3f(0.3f, 0.9f, 1.0f); else glColor3fv(&steel.x);
+	sphereAt(PxVec3(0.001f, 0, 0), 0.006f, 10);
+
+	// barrel: orange, tapering toward the head, rounded rear
+	glColor3fv(&orange.x);
+	cylBetween(PxVec3(-0.165f, 0, 0), PxVec3(-0.050f, 0, 0), 0.019f, 0.024f, 16, true);
+	sphereAt(PxVec3(-0.165f, 0, 0), 0.019f, 12);
+	// brass fitting on top of the rear
+	glColor3fv(&brass.x);
+	cylBetween(PxVec3(-0.150f, 0.016f, 0), PxVec3(-0.150f, 0.030f, 0), 0.006f, 0.006f, 10, true);
+
+	// grip: ribbed black rubber hanging down and slightly back
+	const PxVec3 g = PxVec3(-0.26f, -0.97f, 0).getNormalized();
+	const PxVec3 gripTop(-0.115f, -0.012f, 0), gripBot = gripTop + g * 0.115f;
+	glColor3fv(&rubber.x);
+	cylBetween(gripTop, gripBot, 0.017f, 0.019f, 14, true);
+	for (int i = 0; i < 6; ++i)                                   // ribs
+	{
+		const PxVec3 c = gripTop + g * (0.020f + 0.015f * i);
+		cylBetween(c, c + g * 0.005f, 0.0205f, 0.0205f, 14, false);
+	}
+	glColor3f(1.0f, 0.45f, 0.05f);                                // orange dots on the front face of the grip
+	for (int i = 0; i < 4; ++i)
+	{
+		const PxVec3 c = gripTop + g * (0.035f + 0.02f * i) + PxVec3(0.017f, 0.004f, 0);
+		sphereAt(c, 0.0045f, 8);
+	}
+	// hose connector + hose trailing away
+	glColor3fv(&brass.x);
+	cylBetween(gripBot, gripBot + g * 0.022f, 0.015f, 0.013f, 12, true);
+	glColor3f(0.12f, 0.32f, 0.18f);
+	cylBetween(gripBot + g * 0.022f, gripBot + g * 0.45f, 0.011f, 0.011f, 12, true);
+
+	// trigger lever behind the grip: pivot near the barrel rear, swings in when spraying
+	const float pull = on ? 0.5f : 0.0f;
+	const PxVec3 pivot(-0.168f, -0.024f, 0);
+	const PxVec3 lever = PxVec3(-0.42f + 0.14f * pull, -0.91f, 0).getNormalized();   // hangs behind the grip
+	glColor3fv(&black.x);
+	cylBetween(pivot, pivot + lever * 0.105f, 0.007f, 0.006f, 10, true);
+	cylBetween(pivot + lever * 0.105f, pivot + lever * 0.105f + PxVec3(0.02f, -0.008f, 0), 0.006f, 0.005f, 8, true);
+	glColor3fv(&steel.x);
+	sphereAt(pivot, 0.0065f, 10);
+
+	glPopMatrix();
+	glPopAttrib();
+}
