+"  vec4 eye = gl_ModelViewMatrix * vec4(gl_Vertex.xyz, 1.0);\n"
+"  posEye = eye.xyz;\n"
+"  life = useLife == 1 ? clamp(gl_Vertex.w, 0.0, 1.0) : 1.0;\n"
+"  gl_PointSize = pointRadius * pointScale / max(-eye.z, 0.001);\n"
+"  gl_Position = gl_ProjectionMatrix * eye;\n"
+"}\n";
+
+static const char* kSpriteFS =
+"uniform float pointRadius;\n"
+"uniform vec3  color;\n"
+"uniform float alpha;\n"
+"uniform vec3  lightEye;\n"
+"varying vec3  posEye;\n"
+"varying float life;\n"
+"void main() {\n"
+"  vec3 N;\n"
+"  N.xy = gl_PointCoord * 2.0 - 1.0;\n"
+"  float r2 = dot(N.xy, N.xy);\n"
+"  if (r2 > 1.0) discard;\n"
+"  N.z = sqrt(1.0 - r2);\n"
+"  vec4 p = vec4(posEye + N * pointRadius, 1.0);\n"
+"  vec4 clip = gl_ProjectionMatrix * p;\n"
+"  gl_FragDepth = (clip.z / clip.w) * 0.5 + 0.5;\n"
+"  vec3 L = normalize(lightEye);\n"
+"  float diff = max(dot(N, L), 0.0);\n"
+"  vec3 H = normalize(L + vec3(0.0, 0.0, 1.0));\n"
+"  float spec = pow(max(dot(N, H), 0.0), 80.0);\n"
+"  float fres = pow(1.0 - N.z, 3.0);\n"
+"  vec3 c = color * (0.55 + 0.45 * diff) + vec3(1.0) * spec * 1.0 + vec3(0.85, 0.92, 1.0) * fres * 0.8;\n"
+"  gl_FragColor = vec4(c, alpha * (0.3 + 0.7 * life));\n"
+"}\n";
+
+GLuint compileShader(GLenum type, const char* src)
+{
+	GLuint sh = glCreateShader(type);
+	glShaderSource(sh, 1, &src, NULL);
+	glCompileShader(sh);
+	GLint ok = 0; glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+	if (!ok) { char log[2048]; glGetShaderInfoLog(sh, sizeof(log), NULL, log); printf("shader error: %s\n", log); }
+	return sh;
+}
+
+void buildSpriteShader()
+{
+	sSpriteProg = glCreateProgram();
+	glAttachShader(sSpriteProg, compileShader(GL_VERTEX_SHADER, kSpriteVS));
+	glAttachShader(sSpriteProg, compileShader(GL_FRAGMENT_SHADER, kSpriteFS));
+	glLinkProgram(sSpriteProg);
+	GLint ok = 0; glGetProgramiv(sSpriteProg, GL_LINK_STATUS, &ok);
+	if (!ok) { char log[2048]; glGetProgramInfoLog(sSpriteProg, sizeof(log), NULL, log); printf("link error: %s\n", log); }
+	sUniScale  = glGetUniformLocation(sSpriteProg, "pointScale");
+	sUniRadius = glGetUniformLocation(sSpriteProg, "pointRadius");
+	sUniColor  = glGetUniformLocation(sSpriteProg, "color");
+	sUniAlpha  = glGetUniformLocation(sSpriteProg, "alpha");
+	sUniLight  = glGetUniformLocation(sSpriteProg, "lightEye");
+	sUniLife   = glGetUniformLocation(sSpriteProg, "useLife");
+}
+
+// Draws `count` PxVec4 points from a VBO as shaded spheres of world radius `radius`.
+void drawSprites(GLuint vbo, PxU32 count, float radius, const PxVec3& color, float alpha, bool useLife)
+{
+	if (count == 0 || sSpriteProg == 0) return;
+	const float H = float(Snippets::getScreenHeight());
+	const float pointScale = H / tanf(PxDegToRad(30.0f));          // 60 degree vertical FOV
+	// light direction in eye space (the snippet renderer's fixed light)
+	float mv[16]; glGetFloatv(GL_MODELVIEW_MATRIX, mv);
+	const PxVec3 Lw = PxVec3(-1.0f, 1.0f, 0.5f).getNormalized();
+	const PxVec3 Le(mv[0] * Lw.x + mv[4] * Lw.y + mv[8] * Lw.z,
+	                mv[1] * Lw.x + mv[5] * Lw.y + mv[9] * Lw.z,
+	                mv[2] * Lw.x + mv[6] * Lw.y + mv[10] * Lw.z);
+
+	glPushAttrib(GL_ENABLE_BIT | GL_COLOR_BUFFER_BIT | GL_POINT_BIT);
+	glDisable(GL_LIGHTING);
+	glDisable(GL_TEXTURE_2D);
+	glEnable(GL_POINT_SPRITE);
+	glEnable(GL_VERTEX_PROGRAM_POINT_SIZE);
+	glPointParameteri(GL_POINT_SPRITE_COORD_ORIGIN, GL_LOWER_LEFT);
+	glEnable(GL_BLEND);
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+	glUseProgram(sSpriteProg);
+	glUniform1f(sUniScale, pointScale);
+	glUniform1f(sUniRadius, radius);
+	glUniform3f(sUniColor, color.x, color.y, color.z);
+	glUniform1f(sUniAlpha, alpha);
+	glUniform3f(sUniLight, Le.x, Le.y, Le.z);
+	glUniform1i(sUniLife, useLife ? 1 : 0);
+
+	glBindBuffer(GL_ARRAY_BUFFER, vbo);
+	glEnableClientState(GL_VERTEX_ARRAY);
+	glVertexPointer(4, GL_FLOAT, sizeof(PxVec4), 0);
+	glDrawArrays(GL_POINTS, 0, count);
+	glDisableClientState(GL_VERTEX_ARRAY);
+	glBindBuffer(GL_ARRAY_BUFFER, 0);
+	glUseProgram(0);
+	glPopAttrib();
+}
+
+// ---------------------------------------------------------------- orbit camera
+// Left drag: orbit around the run.  Right drag: pan.  Wheel / middle drag: zoom.  C: reset view.
+// Home view: a child standing at the front-right corner looking down on the run (eye ~1.6 m up).
+static const PxVec3 kHomeTarget(-0.02f, 0.40f, 0.08f);  // offset left so the run sits right of the panel
+static const float  kHomeDist = 1.35f, kHomeYaw = 0.45f, kHomePitch = 0.5f;
+PxVec3 sTarget = kHomeTarget;
+float  sYaw = kHomeYaw, sPitch = kHomePitch, sDist = kHomeDist;
+int    sLastX = 0, sLastY = 0, sButton = -1;
+
+void applyOrbit()
+{
+	const float cp = cosf(sPitch), sp = sinf(sPitch);
+	const PxVec3 dir(-sinf(sYaw) * cp, -sp, -cosf(sYaw) * cp);   // eye -> target
+	sCamera->setPose(sTarget - dir * sDist, dir);
+}
+
+PxVec3 orbitDir()
+{
+	const float cp = cosf(sPitch), sp = sinf(sPitch);
+	return PxVec3(-sinf(sYaw) * cp, -sp, -cosf(sYaw) * cp);
+}
+
+void drawSky()
+{
+	const PxVec3 eye = sTarget - orbitDir() * sDist;
+	glPushAttrib(GL_ENABLE_BIT | GL_DEPTH_BUFFER_BIT | GL_CURRENT_BIT);
+	glDisable(GL_LIGHTING);
+	glDisable(GL_CULL_FACE);
+	glDepthMask(GL_FALSE);
+	glEnable(GL_TEXTURE_2D);
+	glBindTexture(GL_TEXTURE_2D, sSkyTex);
+	glColor3f(1.0f, 1.0f, 1.0f);
+	glPushMatrix();
+	glTranslatef(eye.x, eye.y, eye.z);
+	glRotatef(-90.0f, 1.0f, 0.0f, 0.0f);          // gluSphere's pole is +z; put it on +y
+	GLUquadric* q = gluNewQuadric();
+	gluQuadricTexture(q, GL_TRUE);
+	gluQuadricOrientation(q, GLU_INSIDE);
+	gluSphere(q, 80.0, 48, 24);
+	gluDeleteQuadric(q);
+	glPopMatrix();
+	glDepthMask(GL_TRUE);
+	glPopAttrib();
+}
+
+// Soft planar shadows: flatten every visible shape onto y = 0 along the light direction and
+// multiply the framebuffer by a dim colour.  Depth writes are off so the flattened geometry
+// never occludes anything; polygon offset lifts it just above the deck.
+void drawShadows(PxRigidActor** actors, PxU32 n)
+{
+	const PxVec3 L = PxVec3(-1.0f, 1.0f, 0.5f).getNormalized();   // towards the light
+	const float dx = -L.x, dy = -L.y, dz = -L.z;                     // light travel direction
+	const float m[16] = { 1, 0, 0, 0,   -dx / dy, 0, -dz / dy, 0,   0, 0, 1, 0,   0, 0, 0, 1 };
+	glPushAttrib(GL_ENABLE_BIT | GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_POLYGON_BIT | GL_CURRENT_BIT);
+	glDisable(GL_LIGHTING);
+	glDisable(GL_TEXTURE_2D);
+	glEnable(GL_BLEND);
+	glBlendFunc(GL_ZERO, GL_SRC_COLOR);
+	glDepthMask(GL_FALSE);
+	glEnable(GL_POLYGON_OFFSET_FILL);
+	glPolygonOffset(-2.0f, -2.0f);
+	glPushMatrix();
+	glMultMatrixf(m);
+	Snippets::renderActors(actors, n, false, PxVec3(0.45f, 0.45f, 0.52f), NULL, false, false);
+	glPopMatrix();
+	glPopAttrib();
+}
+
+void setupFog(bool on)
+{
+	if (!on) { glDisable(GL_FOG); return; }
+	const float fogColor[] = { 0.78f, 0.86f, 0.95f, 1.0f };   // the sky's horizon colour
+	glEnable(GL_FOG);
+	glFogi(GL_FOG_MODE, GL_LINEAR);
+	glFogfv(GL_FOG_COLOR, fogColor);
+	glFogf(GL_FOG_START, 6.0f);
+	glFogf(GL_FOG_END, 45.0f);
+}
+
+// Chute pieces (half-pipes, funnel, bowl) as smoky translucent plastic: drawn after the water with
+// depth writes off so the stream stays visible through the front wall.
+void drawChutes(const std::vector<PxRigidActor*>& chutes)
+{
+	if (chutes.empty()) return;
+	glPushAttrib(GL_ENABLE_BIT | GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_CURRENT_BIT);
+	glEnable(GL_LIGHTING);
+	glDisable(GL_TEXTURE_2D);
+	glEnable(GL_BLEND);
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	glDepthMask(GL_FALSE);
+	glEnable(GL_CULL_FACE);
+	glCullFace(GL_BACK);
+	glColor4f(0.62f, 0.78f, 0.92f, 0.45f);
+	PxShape* shapes[128];
+	for (size_t i = 0; i < chutes.size(); ++i)
+	{
+		const PxU32 n = chutes[i]->getShapes(shapes, 128);
+		for (PxU32 j = 0; j < n; ++j)
+		{
+			if (shapes[j]->getGeometry().getType() != PxGeometryType::eBOX) continue;
+			const PxBoxGeometry& box = static_cast<const PxBoxGeometry&>(shapes[j]->getGeometry());
+			const PxMat44 pose(PxShapeExt::getGlobalPose(*shapes[j], *chutes[i]));
+			glPushMatrix();
+			glMultMatrixf(&pose.column0.x);
+			glScalef(2.0f * box.halfExtents.x, 2.0f * box.halfExtents.y, 2.0f * box.halfExtents.z);
+			glutSolidCube(1.0);
+			glPopMatrix();
+		}
+	}
+	glPopAttrib();
+}
+
+// ---------------------------------------------------------------- UI overlay (CUDA nbody / paramgl style)
+// A column of rows like the nbody sample's ParamListGL: GLUT 9x15 bitmap text in name / value
+// columns, thin outlined yellow bars for sliders, little switches for toggles, hovered row in white,
+// no panel box.  Rows are clickable; sliders drag.
+enum RowKind { ROW_TITLE, ROW_SLIDER, ROW_TOGGLE, ROW_ACTION, ROW_INFO, ROW_HINT, ROW_SWATCH };
+enum RowId { R_TITLE, R_HOSE, R_FLOW, R_MAXP, R_ACTIVE, R_RADIUS, R_DROP, R_PLACE, R_BUILD, R_TILECOL, R_TILESHAPE, R_CLEARB, R_CLEARW, R_PAUSE, R_WIRE, R_VIEW, R_UISIZE, R_QUIT, R_HINT, ROW_COUNT };
+struct Row { RowKind kind; const char* name; };
+static const Row kRows[ROW_COUNT] = {
+	{ ROW_TITLE,  "PhysX 5.3 ball run" },
+	{ ROW_TOGGLE, "Hose (H)"           },
+	{ ROW_SLIDER, "Hose flow (- =)"    },
+	{ ROW_SLIDER, "Max particles"      },
+	{ ROW_INFO,   "Active water"       },
+	{ ROW_SLIDER, "Ball radius ([ ])"  },
+	{ ROW_ACTION, "Drop ball (B)"      },
+	{ ROW_TOGGLE, "Place mode (M)"     },
+	{ ROW_TOGGLE, "Build mode (T)"     },
+	{ ROW_SWATCH, "Tile colour (1-6)"  },
+	{ ROW_TOGGLE, "Tile shape"         },
+	{ ROW_ACTION, "Clear balls (X)"    },
+	{ ROW_ACTION, "Clear water (W)"    },
+	{ ROW_TOGGLE, "Pause (P)"          },
+	{ ROW_TOGGLE, "Wireframe (F)"      },
+	{ ROW_ACTION, "Reset view (C)"     },
+	{ ROW_SLIDER, "UI size"            },
+	{ ROW_ACTION, "Quit (Esc)"         },
+	{ ROW_HINT,   ""                   },
+};
+
+int sUiSize = 0;   // 0 = automatic from window width, else 1..4
+int uiScale()
+{
+	if (sUiSize > 0) return sUiSize;
+	const int w = int(Snippets::getScreenWidth());
+	return w >= 2600 ? 3 : (w >= 1400 ? 2 : 1);
+}
+struct UiGeom { int S, charW, fontH, rowH, x0, y0, nameX, valueX, barX, barW, barH, keyX, width; };
+UiGeom uiGeom()
+{
+	UiGeom g;
+	g.S = uiScale(); g.fontH = 15 * g.S; g.charW = (g.fontH * 10) / 16; g.rowH = 17 * g.S;
+	g.x0 = 8 * g.S; g.y0 = 8 * g.S;
+	g.nameX  = g.x0 + 5 * g.S;
+	g.valueX = g.x0 + 19 * g.charW;
+	g.barX   = g.x0 + 27 * g.charW;
+	g.barW   = 10 * g.charW;
+	g.barH   = 10 * g.S;
+	g.keyX   = 0;
+	g.width  = g.barX + g.barW + g.charW;
+	return g;
+}
+
+int    sHoverRow = -1;
+int    sSliderDrag = -1;        // row being dragged
+bool   sPlaceMode = false;
+bool   sBuildMode = false;
+PxU32  sTileColour = 0;
+bool   sTileRing = false;
+PxRigidActor* sHoverTile = NULL;
+PxRigidActor* sDragTile = NULL;
+PxVec3 sDragPlaneN(0, 0, 1), sDragOffset(0.0f);
+bool   sTileGhostValid = false;
+PxVec3 sTileGhostPos(0.0f);
+int    sCursorX = -1, sCursorY = -1;
+int    sPressX = 0, sPressY = 0;
+bool   sGhostValid = false;
+PxVec3 sGhostPos(0.0f);
+
+int rowAt(int x, int y)
+{
+	const UiGeom g = uiGeom();
+	if (x < 0 || x >= g.width || y < g.y0) return -1;
+	const int i = (y - g.y0) / g.rowH;
+	return i < ROW_COUNT ? i : -1;
+}
+
+bool inPanel(int x, int y) { return rowAt(x, y) >= 0; }
+
+// slider value <-> 0..1.  Max particles is log scale 100..capacity; the others are linear.
+float sliderT(int row)
+{
+	switch (row)
+	{
+	case R_FLOW:   return PxClamp(getHoseFlow(), 0.0f, 1.0f);
+	case R_UISIZE: return float(uiScale() - 1) / 3.0f;
+	case R_RADIUS: return PxClamp((getBallRadius() - 0.012f) / 0.020f, 0.0f, 1.0f);
+	case R_MAXP:
+	{
+		const float lo = logf(100.0f), hi = logf(float(getParticleCapacity()));
+		return PxClamp((logf(float(getMaxActiveParticles())) - lo) / (hi - lo), 0.0f, 1.0f);
+	}
+	default: return 0.0f;
+	}
+}
+
+void sliderSet(int row, float t)
+{
+	t = PxClamp(t, 0.0f, 1.0f);
+	switch (row)
+	{
+	case R_FLOW:   setHoseFlow(floorf(t * 20.0f + 0.5f) / 20.0f); break;                          // 5% steps
+	case R_UISIZE: sUiSize = 1 + int(t * 3.0f + 0.5f); break;
+	case R_RADIUS: setBallRadius(floorf((0.012f + t * 0.020f) * 1000.0f + 0.5f) / 1000.0f); break; // 1 mm steps
+	case R_MAXP:
+	{
+		const float lo = logf(100.0f), hi = logf(float(getParticleCapacity()));
+		PxU32 v = PxU32(expf(lo + t * (hi - lo)) + 0.5f);
+		setMaxActiveParticles(PxMax((v / 100) * 100, 100u));
+		break;
+	}
+	default: break;
+	}
+}
+
+void sliderSetFromX(int row, int x)
+{
+	const UiGeom g = uiGeom();
+	sliderSet(row, float(x - g.barX) / float(g.barW));
+}
+
+bool toggleValue(int row)
+{
+	switch (row)
+	{
+	case R_HOSE:  return isHoseOn();
+	case R_PLACE: return sPlaceMode;
+	case R_BUILD: return sBuildMode;
+	case R_TILESHAPE: return sTileRing;
+	case R_PAUSE: return isPaused();
+	case R_WIRE:  return sWireframe;
+	default: return false;
+	}
+}
+
+void pressRow(int row)
+{
+	switch (row)
+	{
+	case R_HOSE:   setHoseOn(!isHoseOn()); break;
+	case R_PLACE:  sPlaceMode = !sPlaceMode; if (sPlaceMode) sBuildMode = false; break;
+	case R_BUILD:  sBuildMode = !sBuildMode; if (sBuildMode) sPlaceMode = false; sDragTile = NULL; break;
+	case R_TILESHAPE: sTileRing = !sTileRing; break;
+	case R_PAUSE:  setPaused(!isPaused()); break;
+	case R_WIRE:   sWireframe = !sWireframe; break;
+	case R_DROP:   dropBall(); break;
+	case R_CLEARB: clearBalls(); break;
+	case R_CLEARW: clearWater(); break;
+	case R_VIEW:   sTarget = kHomeTarget; sYaw = kHomeYaw; sPitch = kHomePitch; sDist = kHomeDist; break;
+	case R_QUIT:   glutLeaveMainLoop(); break;
+	default: break;
+	}
+}
+
+// Cursor -> world ray, using the same basis gluLookAt builds in startRender (up = +y).
+PxVec3 cursorRay(int x, int y)
+{
+	const float w = float(Snippets::getScreenWidth()), h = float(Snippets::getScreenHeight());
+	const float u = (float(x) / w) * 2.0f - 1.0f;
+	const float v = 1.0f - (float(y) / h) * 2.0f;
+	const float t = tanf(PxDegToRad(30.0f));   // half of the 60 degree vertical FOV
+	const PxVec3 f = orbitDir();
+	const PxVec3 sdir = f.cross(PxVec3(0, 1, 0)).getNormalized();
+	const PxVec3 up = sdir.cross(f);
+	return (f + sdir * (u * t * w / h) + up * (v * t)).getNormalized();
+}
+
+bool hitHose(int x, int y)
+{
+	PxVec3 tip, dir; PxReal r; getHose(tip, dir, r);
+	const PxVec3 centre = tip - dir * 0.06f;
+	const float  radius = 0.09f;
+	const PxVec3 eye = sTarget - orbitDir() * sDist;
+	const PxVec3 ray = cursorRay(x, y);
+	const PxVec3 oc = eye - centre;
+	const float b = oc.dot(ray), c = oc.dot(oc) - radius * radius;
+	return b * b - c >= 0.0f && (-b + sqrtf(b * b - c)) > 0.0f;
+}
+
+PxRigidActor* tileUnderCursor(int x, int y, PxVec3& hitPos)
+{
+	const PxVec3 eye = sTarget - orbitDir() * sDist;
+	return pickTile(eye, cursorRay(x, y), hitPos);
+}
+
+// Ghost for a new tile: cursor ray onto the backdrop plane, snapped to the tile grid.
+void updateTileGhost()
+{
+	sTileGhostValid = false;
+	if (!sBuildMode || sCursorX < 0 || inPanel(sCursorX, sCursorY) || sHoverTile || sDragTile) return;
+	const PxReal T = getTileSize(), zc = -0.5f * getTileThickness();
+	const PxVec3 eye = sTarget - orbitDir() * sDist;
+	const PxVec3 ray = cursorRay(sCursorX, sCursorY);
+	if (fabsf(ray.z) < 1e-4f) return;
+	const float t = (zc - eye.z) / ray.z;
+	if (t <= 0.0f) return;
+	PxVec3 p = eye + ray * t;
+	p.x = (floorf(p.x / T) + 0.5f) * T;
+	p.y = PxMax(0.5f * T, (floorf(p.y / T) + 0.5f) * T);
+	p.z = zc;
+	sTileGhostPos = p;
+	sTileGhostValid = true;
+}
+
+// Drag: slide the tile within its own plane (normal preserved), snapped to half a tile.
+void dragTileTo(int x, int y)
+{
+	const PxVec3 eye = sTarget - orbitDir() * sDist;
+	const PxVec3 ray = cursorRay(x, y);
+	const float denom = ray.dot(sDragPlaneN);
+	if (fabsf(denom) < 1e-4f) return;
+	PxVec3 c, n, up; getTileFrame(sDragTile, c, n, up);
+	const float t = (c - eye).dot(sDragPlaneN) / denom;
+	if (t <= 0.0f) return;
+	PxVec3 target = eye + ray * t - sDragOffset;
+	const PxReal g = 0.5f * getTileSize();
+	// snap the in-plane coordinates on the two axes with the largest in-plane extent
+	for (int axis = 0; axis < 3; ++axis)
+		if (fabsf(sDragPlaneN[axis]) < 0.5f) target[axis] = floorf(target[axis] / g + 0.5f) * g;
+	target.y = PxMax(target.y, 0.5f * getTileSize());
+	target -= sDragPlaneN * sDragPlaneN.dot(target - c);       // stay exactly on the tile's own plane
+	moveTile(sDragTile, target);
+}
+
+void updateGhost()
+{
+	sGhostValid = false;
+	if (!sPlaceMode || sCursorX < 0 || inPanel(sCursorX, sCursorY)) return;
+	const PxVec3 eye = sTarget - orbitDir() * sDist;
+	const PxVec3 ray = cursorRay(sCursorX, sCursorY);
+	if (fabsf(ray.z) < 1e-4f) return;
+	PxReal w, h, trackZ; getRunExtent(w, h, trackZ);
+	const float t = (trackZ - eye.z) / ray.z;   // hit the track's centre plane
+	if (t <= 0.0f) return;
+	const PxReal r = getBallRadius();
+	PxVec3 p = eye + ray * t;
+	p.x = PxClamp(p.x, r + 0.005f, w - r - 0.005f);
+	p.y = PxClamp(p.y, r + 0.005f, h + 0.3f);
+	p.z = trackZ;
+	sGhostPos = p;
+	sGhostValid = true;
+}
+
+void orbitMouse(int button, int state, int x, int y)
+{
+	sCursorX = x; sCursorY = y;
+	if (button == 3 || button == 4)   // freeglut wheel up / down
+	{
+		if (state == GLUT_DOWN && !inPanel(x, y))
+			sDist = PxClamp(sDist * (button == 3 ? 0.9f : 1.1f), 0.2f, 20.0f);
+		return;
+	}
+	if (state == GLUT_DOWN)
+	{
+		sPressX = x; sPressY = y;
+		const int row = rowAt(x, y);
+		if (button == GLUT_LEFT_BUTTON && row >= 0)
+		{
+			const UiGeom g = uiGeom();
+			const RowKind k = kRows[row].kind;
+			if (k == ROW_SLIDER && x >= g.barX - g.charW)
+			{
+				sSliderDrag = row; sliderSetFromX(row, x);
+			}
+			else if (k == ROW_SWATCH)
+			{
+				const int sw = g.barH + 6 * g.S, gap = 4 * g.S;
+				const int i = (x - g.barX) / (sw + gap);
+				if (x >= g.barX && i >= 0 && i < 6) sTileColour = PxU32(i);
+			}
+			else if (k == ROW_TOGGLE || k == ROW_ACTION)
+				pressRow(row);
+			sButton = -1;
+			return;
+		}
+		if (sBuildMode && button == GLUT_LEFT_BUTTON)
+		{
+			PxVec3 hp;
+			if (PxRigidActor* tile = tileUnderCursor(x, y, hp))
+			{
+				PxVec3 c, n, up; getTileFrame(tile, c, n, up);
+				sDragTile = tile; sDragPlaneN = n;
+				sDragOffset = (hp - c) - n * n.dot(hp - c);   // in-plane only, so the tile never leaves its plane
+				sButton = -1;
+				return;
+			}
+		}
+		sButton = button;
+	}
+	else
+	{
+		sSliderDrag = -1;
+		if (sDragTile) { sDragTile = NULL; sButton = -1; sLastX = x; sLastY = y; return; }
+		const bool bclick = abs(x - sPressX) < 4 && abs(y - sPressY) < 4;
+		if (sBuildMode && bclick && !inPanel(x, y))
+		{
+			PxVec3 hp;
+			PxRigidActor* tile = tileUnderCursor(x, y, hp);
+			if (button == GLUT_RIGHT_BUTTON && tile) { if (sHoverTile == tile) sHoverTile = NULL; removeTile(tile); }
+			else if (button == GLUT_LEFT_BUTTON && !tile)
+			{
+				sHoverTile = NULL; updateTileGhost();
+				if (sTileGhostValid) createTile(sTileGhostPos, PxVec3(0, 0, 1), PxVec3(0, 1, 0), sTileColour, sTileRing);
+			}
+			sButton = -1; sLastX = x; sLastY = y;
+			return;
+		}
+		const bool click = abs(x - sPressX) < 4 && abs(y - sPressY) < 4;
+		if (button == GLUT_LEFT_BUTTON && click && !inPanel(x, y) && hitHose(x, y))
+			setHoseOn(!isHoseOn());
+		else if (button == GLUT_LEFT_BUTTON && click && sPlaceMode && !inPanel(x, y))
+		{
+			updateGhost();
+			if (sGhostValid) spawnBall(sGhostPos, getBallRadius());
+		}
+		sButton = -1;
+	}
+	sLastX = x; sLastY = y;
+}
