+// Equirectangular sky: v = 1 is the zenith, v = 0.5 the horizon.  Gradient + sun glow + fbm clouds.
+void buildSkyTexture()
+{
+	const int W = 512, H = 256;
+	std::vector<unsigned char> px(W * H * 3);
+	const PxVec3 sunDir = PxVec3(-1.0f, 1.0f, 0.5f).getNormalized();   // same as the snippet renderer's light
