+void drawTileEditor()
+{
+	if (!sBuildMode) return;
+	const PxReal T = getTileSize(), th = getTileThickness();
+	glPushAttrib(GL_ENABLE_BIT | GL_CURRENT_BIT | GL_LINE_BIT | GL_DEPTH_BUFFER_BIT);
