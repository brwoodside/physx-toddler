+float hash2(int x, int y)
+{
+	unsigned int h = unsigned(x) * 374761393u + unsigned(y) * 668265263u;
+	h = (h ^ (h >> 13)) * 1274126177u;
+	return float(h & 0xffffff) / float(0xffffff);
+}
+
+float vnoise(float x, float y)   // value noise, bilinear, tileable if the caller wraps
+{
+	const int xi = int(floorf(x)), yi = int(floorf(y));
+	const float fx = x - floorf(x), fy = y - floorf(y);
+	const float sx = fx * fx * (3.0f - 2.0f * fx), sy = fy * fy * (3.0f - 2.0f * fy);
+	const float a = hash2(xi, yi), b = hash2(xi + 1, yi), c = hash2(xi, yi + 1), d = hash2(xi + 1, yi + 1);
+	return (a + (b - a) * sx) + ((c - a) + (a - b + d - c) * sx) * sy;
+}
+
+float fbm(float x, float y, int octaves)
+{
+	float v = 0.0f, amp = 0.5f, sum = 0.0f;
+	for (int i = 0; i < octaves; ++i) { v += amp * vnoise(x, y); sum += amp; x *= 2.03f; y *= 1.97f; amp *= 0.5f; }
+	return v / sum;
+}
