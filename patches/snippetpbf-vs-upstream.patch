+void orbitPassiveMotion(int x, int y)
+{
+	sCursorX = x; sCursorY = y;
+	sHoverRow = rowAt(x, y);
+	PxVec3 hp;
+	sHoverTile = (sBuildMode && sHoverRow < 0) ? tileUnderCursor(x, y, hp) : NULL;
